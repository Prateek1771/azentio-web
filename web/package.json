{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "seed": "node --env-file=.env.local --experimental-strip-types scripts/seed.mts",
    "demo:create": "node --env-file=.env.local --experimental-strip-types scripts/demo-accounts.mts create",
    "demo:verify": "node --env-file=.env.local --experimental-strip-types scripts/demo-accounts.mts verify",
    "demo:resend": "node --env-file=.env.local --experimental-strip-types scripts/demo-accounts.mts resend",
    "test:rls": "node --env-file=.env.local --experimental-strip-types scripts/test-rls.mts",
    "test:outbox": "node --env-file=.env.local --experimental-strip-types scripts/test-outbox.mts",
    "test:unit": "node --experimental-strip-types lib/playground/engines.test.mts && node --experimental-strip-types lib/contributions/pii.test.mts",
    "test:e2e:prod": "node -e \"process.env.PW_PROD='1';require('child_process').execSync('npx playwright test',{stdio:'inherit',env:process.env})\""
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@insforge/sdk": "^1.5.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "framer-motion": "^14.8.0",
    "lucide-react": "^1.65.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "openai": "^7.45.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
