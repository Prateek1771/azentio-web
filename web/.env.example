# InsForge (user-scoped; safe in the browser)
NEXT_PUBLIC_INSFORGE_URL=https://your-project.region.insforge.app
NEXT_PUBLIC_INSFORGE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3100

# Server-only secrets — never prefix with NEXT_PUBLIC_
INSFORGE_API_KEY=
# InsForge Model Gateway key (free $1 credit): npx -y @insforge/cli ai setup
OPENROUTER_API_KEY=
# Optional model override for AIRA and the AI assists
AIRA_MODEL=openai/gpt-4o-mini

# Minimum distinct organisations before a trend count is shown
K_MIN_ORGS=3

# Email outbox: the worker endpoint secret; real delivery needs a paid InsForge plan (EMAIL_DELIVERY=insforge)
OUTBOX_RUN_SECRET=
EMAIL_DELIVERY=

# One-click demo sign-in (admin roles). Passwords are server-only; set via npm run demo:create
DEMO_LOGIN_ENABLED=false
DEMO_INBOX=
